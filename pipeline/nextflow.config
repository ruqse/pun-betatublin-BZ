// P. univalens beta-tubulin pipeline: parameters and profiles

params {
    samplesheet    = "${projectDir}/../data/metadata/samplesheet.csv"
    reads_dir      = null                                  // directory with the 14 HiFi FASTQ files
    ref_dir        = "${projectDir}/../data/reference"     // per-gene guides and CDS references
    reference      = "${projectDir}/../data/reference/Betatublin_scaffolds_genomic.fa"  // bin/prepare_reference.sh
    outdir         = "results_pipeline"
    run_vep        = false
    vep_gff        = null                                  // WBPS19 GFF3 (see README)
    vep_fasta      = null                                  // WBPS19 genome FASTA (see README)
    run_chimera_qc = true
    project        = null                                  // SLURM account (uppmax profile)
}

process {
    cpus   = 1
    memory = { 8.GB * task.attempt }
    time   = { 4.h * task.attempt }
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] ? 'retry' : 'finish' }
    maxRetries = 2

    // Resources follow the published SLURM jobs (pbaa was given up to 600 GB)
    withName: 'CALL' {
        memory = { 128.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'PBAA' {
        memory = { 200.GB * task.attempt }
        time   = { 16.h * task.attempt }
    }
    withName: 'CHIMERA_QC' {
        time   = { 8.h * task.attempt }
    }
}

singularity {
    enabled    = true
    autoMounts = true
}

profiles {
    standard {
        process.executor = 'local'
    }
    docker {
        singularity.enabled = false
        docker.enabled      = true
    }
    uppmax {
        includeConfig 'conf/uppmax.config'
    }
    test {
        // Smallest gene (Pun-bt-C, 13,295 reads per farm) for a quick end-to-end check
        params.samplesheet = "${projectDir}/tests/samplesheet_test.csv"
    }
}

manifest {
    name            = 'pun-betatublin-BZ'
    description     = 'PacBio HiFi amplicon variants and haplotypes of the seven Parascaris univalens beta-tubulin genes'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.0'
}
