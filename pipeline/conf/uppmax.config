// UPPMAX (Pelle) SLURM profile. Pass your account with --project.

process {
    executor       = 'slurm'
    clusterOptions = { "-A ${params.project}" }
}

executor {
    queueSize = 20
}

singularity {
    // /proj is a symlink farm into /gorilla on Pelle; bind both so containers see inputs
    runOptions = '--bind /proj,/gorilla'
    cacheDir = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${launchDir}/singularity_cache"
}
